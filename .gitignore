# ==============================================================================
# MarketPilot AI - Git Ignore Configuration
# Privacy, Security, Secrets, and Environment Protection
# ==============================================================================

# --- Secrets, API Keys & Environment Variables (Strict Privacy) ---
.env
.env.*
!.env.example
*.env
*.env.*
*.key
*.pem
*.cert
*.crt
secrets.json
credentials.json

# --- User Database & Authentication Data (Privacy) ---
backend/data/*.json
!backend/data/.gitkeep
data/*.json
!data/.gitkeep

# --- Python Artifacts & Caches ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# --- Python Virtual Environments ---
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/

# --- Node / JavaScript Dependencies & Builds ---
node_modules/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-store/

# Vite production build output (re-built via npm run build)
dist/
dist-ssr/
*.local

# --- IDEs, Editors & OS Files ---
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# --- Logs, Diagnostics & Temp Files ---
*.log
logs/
temp/
tmp/
*.tmp
*.bak
*.swp
*~
